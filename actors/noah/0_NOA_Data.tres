[sub_resource type="Resource" id="outro_0"]
script = ExtResource("1")
StateIndex = -1
FinalMessage = "...Stay down. I can't hold it
back much longer."
metadata/_custom_type_script = "uid://bne635raru5sj"

[sub_resource type="Resource" id="outro_1"]
script = ExtResource("1")
StateIndex = -1
ForOpponent = "Noah"
FinalMessage = "So that's what I look like
when it takes over. Hm."
metadata/_custom_type_script = "uid://bne635raru5sj"

[sub_resource type="Resource" id="outro_2"]
script = ExtResource("1")
StateIndex = -1
ForOpponent = "Cecilia"
FinalMessage = "Your lightning's bright, Cecilia.
The dark still swallowed it."
metadata/_custom_type_script = "uid://bne635raru5sj"

[sub_resource type="Resource" id="outro_3"]
script = ExtResource("1")
StateIndex = -1
ForOpponent = "Flan"
FinalMessage = "Starlight, huh. It tasted
warm. Sorry."
metadata/_custom_type_script = "uid://bne635raru5sj"

[sub_resource type="Resource" id="outro_4"]
script = ExtResource("1")
StateIndex = -1
ForOpponent = "Leticia"
FinalMessage = "Light bends near a black hole.
Your shots never had a chance."
metadata/_custom_type_script = "uid://bne635raru5sj"

