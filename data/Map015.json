{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["Present Time. Unknown Area. "]},{"code":231,"indent":0,"parameters":[1,"BG/Forest",0,0,-160,0,180,180,255,0]},{"code":230,"indent":0,"parameters":[300]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,"Girl's Voice"]},{"code":401,"indent":0,"parameters":["...Hrm...."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Girl's Voice"]},{"code":401,"indent":0,"parameters":["W-Where...?"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Girl's Voice"]},{"code":401,"indent":0,"parameters":["What was that dream...?"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":[".........................."]},{"code":231,"indent":0,"parameters":[4,"profile/fullbody/profile_actor_1",0,0,424,704,100,100,255,0]},{"code":232,"indent":0,"parameters":[4,0,0,0,480,-64,100,100,255,0,30,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"Girl with Katana"]},{"code":401,"indent":0,"parameters":["W-Where am I!? What happened to everyone?!"]},{"code":232,"indent":0,"parameters":[4,0,0,0,-8,-64,100,100,255,0,30,true,0]},{"code":357,"indent":0,"parameters":["MOG_PictureEffects","set_quick_move","Quick Move",{"id":"4","mode":"Up","range":"30","speed":"2","times":"1"}]},{"code":657,"indent":0,"parameters":["ID = 4"]},{"code":657,"indent":0,"parameters":["Direction = Up"]},{"code":657,"indent":0,"parameters":["Range = 30"]},{"code":657,"indent":0,"parameters":["Speed = 2"]},{"code":657,"indent":0,"parameters":["Number of Times = 1"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Girl with Katana"]},{"code":401,"indent":0,"parameters":["Looks like I'm in a forest..."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Boy's Voice"]},{"code":401,"indent":0,"parameters":["Oh! Cecilia! You're finally awake!"]},{"code":232,"indent":0,"parameters":[4,0,0,0,408,-64,100,100,255,0,30,true,0]},{"code":231,"indent":0,"parameters":[2,"profile/fullbody/profile_actor_3",0,0,-456,-24,110,110,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,-456,24,110,110,255,0,30,true,0]},{"code":357,"indent":0,"parameters":["MOG_PictureEffects","set_quick_move","Quick Move",{"id":"4","mode":"Up","range":"30","speed":"2","times":"1"}]},{"code":657,"indent":0,"parameters":["ID = 4"]},{"code":657,"indent":0,"parameters":["Direction = Up"]},{"code":657,"indent":0,"parameters":["Range = 30"]},{"code":657,"indent":0,"parameters":["Speed = 2"]},{"code":657,"indent":0,"parameters":["Number of Times = 1"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Cecilia"]},{"code":401,"indent":0,"parameters":["Eustace!? Is that really you?"]},{"code":357,"indent":0,"parameters":["MOG_PictureEffects","set_quick_move","Quick Move",{"id":"2","mode":"Up","range":"30","speed":"2","times":"1"}]},{"code":657,"indent":0,"parameters":["ID = 2"]},{"code":657,"indent":0,"parameters":["Direction = Up"]},{"code":657,"indent":0,"parameters":["Range = 30"]},{"code":657,"indent":0,"parameters":["Speed = 2"]},{"code":657,"indent":0,"parameters":["Number of Times = 1"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Eustace"]},{"code":401,"indent":0,"parameters":["Indeed! A familiar face is worth more than a sack of mira, as they say!"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Cecilia"]},{"code":401,"indent":0,"parameters":["Haha... it definitely is you..."]},{"code":357,"indent":0,"parameters":["MOG_PictureEffects","set_quick_move","Quick Move",{"id":"2","mode":"Up","range":"30","speed":"2","times":"1"}]},{"code":657,"indent":0,"parameters":["ID = 2"]},{"code":657,"indent":0,"parameters":["Direction = Up"]},{"code":657,"indent":0,"parameters":["Range = 30"]},{"code":657,"indent":0,"parameters":["Speed = 2"]},{"code":657,"indent":0,"parameters":["Number of Times = 1"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Cecilia"]},{"code":401,"indent":0,"parameters":["What's happened?"]},{"code":357,"indent":0,"parameters":["MOG_PictureEffects","set_quick_move","Quick Move",{"id":"4","mode":"Up","range":"30","speed":"2","times":"1"}]},{"code":657,"indent":0,"parameters":["ID = 4"]},{"code":657,"indent":0,"parameters":["Direction = Up"]},{"code":657,"indent":0,"parameters":["Range = 30"]},{"code":657,"indent":0,"parameters":["Speed = 2"]},{"code":657,"indent":0,"parameters":["Number of Times = 1"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Eustace"]},{"code":401,"indent":0,"parameters":["I'm not too sure myself... the last thing I remembered was like... an alarm on the ship..."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Eustace"]},{"code":401,"indent":0,"parameters":["We were definitely airborne. No signs of damages and to make things worse this forest seems endless!"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Eustace"]},{"code":401,"indent":0,"parameters":["Lila and I were searching around while we let you rest."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Cecilia"]},{"code":401,"indent":0,"parameters":["Lila? What about everyone else/"]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["Unfortunately for us, we're the only three here."]},{"code":232,"indent":0,"parameters":[2,0,0,0,-40,-16,110,110,255,0,30,true,0]},{"code":231,"indent":0,"parameters":[3,"profile/fullbody/profile_actor_2",0,0,-440,-88,100,100,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,-440,-88,100,100,255,0,30,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"Eustace"]},{"code":401,"indent":0,"parameters":["You're back, Lila. Oh how the days without you have felt!"]},{"code":357,"indent":0,"parameters":["MOG_PictureEffects","set_quick_move","Quick Move",{"id":"3","mode":"Up","range":"15","speed":"2","times":"1"}]},{"code":657,"indent":0,"parameters":["ID = 3"]},{"code":657,"indent":0,"parameters":["Direction = Up"]},{"code":657,"indent":0,"parameters":["Range = 15"]},{"code":657,"indent":0,"parameters":["Speed = 2"]},{"code":657,"indent":0,"parameters":["Number of Times = 1"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Lila"]},{"code":401,"indent":0,"parameters":["It's only been a hour. Don't flatter yourself."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Lila"]},{"code":401,"indent":0,"parameters":["Good to see you awake, Cecilia. We weren't sure when you would ever wake up."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Cecilia"]},{"code":401,"indent":0,"parameters":["Y-Yeah, sorry... it felt like I was stuck in a dream."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Lila"]},{"code":401,"indent":0,"parameters":["You too?"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Eustace"]},{"code":401,"indent":0,"parameters":["Was it the one where Instructor was doing his usual teammwork excercise!?"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Cecilia"]},{"code":401,"indent":0,"parameters":["How did you know?"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Lila"]},{"code":401,"indent":0,"parameters":["Because we had the same dream. It's very coincidental but as HE would always say..."]},{"code":101,"indent":0,"parameters":["",0,0,2,"All"]},{"code":401,"indent":0,"parameters":["There's no such things as coincindences."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Lila"]},{"code":401,"indent":0,"parameters":["Anyways, Cecilia, now that you're awake I think we can explore together."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Lila"]},{"code":401,"indent":0,"parameters":["There's a path up ahead. I honestly didn't feel all that confident going with Eustace."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Eustace"]},{"code":401,"indent":0,"parameters":["W-W-Why?!"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Lila"]},{"code":401,"indent":0,"parameters":["Your track record of being reliable is very not in your favor."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Cecilia"]},{"code":401,"indent":0,"parameters":["While that may be true, he's still dependable! But with us three I think we can cover more ground. "]},{"code":101,"indent":0,"parameters":["",0,0,2,"Eustace"]},{"code":401,"indent":0,"parameters":["Alrighty then! Let's mosey!"]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[30]},{"code":201,"indent":0,"parameters":[0,14,8,5,0,0]},{"code":211,"indent":0,"parameters":[1]},{"code":235,"indent":0,"parameters":[1]},{"code":235,"indent":0,"parameters":[3]},{"code":235,"indent":0,"parameters":[2]},{"code":235,"indent":0,"parameters":[4]},{"code":230,"indent":0,"parameters":[120]},{"code":222,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
