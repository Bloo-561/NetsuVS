; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NetsuVS"
config/version="0.2"
run/main_scene="res://scenes/title/title_screen.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.01, 0.02, 0.07, 1)
boot_splash/image="res://assets/ui/logo/netsu_vs_logo.png"
config/icon="res://assets/ui/logo/icon.png"
config/windows_native_icon="res://assets/ui/logo/icon.ico"

[audio]

buses/default_bus_layout="res://data/audio_bus_layout.tres"

[autoload]

Controls="*res://game/autoloads/controls.gd"
GameSettings="*res://game/autoloads/game_settings.gd"
SceneRouter="*res://game/autoloads/scene_router.gd"
LoadingScreenManager="*res://engine/autoloads/LoadingScreenManager.cs"
AudioManager="*res://engine/autoloads/AudioManager.tscn"
NetsuOnline="*res://engine/netcode/NetsuOnline.cs"
MatchSetup="*res://game/autoloads/match_setup.gd"
OnlineRoom="*res://game/autoloads/online_room.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="NetsuVS"

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://assets/ui/netsu_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
