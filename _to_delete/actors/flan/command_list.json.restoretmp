{
  "fighter": "Flan Returna",
  "note": "Notes for the command list (docs/command_list.md). Every move in the fighter's data shows up by itself; here, keyed by the ENGINE move name, you can add a display name, description, tags, a shown input, preview states, a group to merge into, or hide a move.",
  "moves": {
    "5A": {"desc": "Quick jab. Chains into B or C."},
    "5B": {"desc": "Straight punch with good reach."},
    "5C": {"desc": "Heavy punch that reaches with a burst of light."},
    "2A": {"desc": "Quick low."},
    "2B": {"desc": "Low punch. Chains into 5B, 5C, 2C and jump."},
    "2C": {"desc": "Sliding punch that knocks down."},
    "6B": {"desc": "Slow overhead: block it standing. Cancels into specials only on hit."},
    "6C": {"name": "Victory Pump", "tags": ["LAUNCHER"], "desc": "Launches. Any ground normal cancels into it. Jump (8) on hit to chase."},
    "j.5A": {"name": "j.A"},
    "j.5B": {"name": "j.B", "desc": "A knee."},
    "j.5C": {"name": "j.C"},
    "Star Fist": {"desc": "Short lunging punch. Follow up with a Star Rush in any direction."},
    "Air Star Fist": {"group": "Star Fist"},
    "Twirling Star Fist": {"tags": ["ARMOR"], "desc": "Arm twirl that absorbs one hit, then a punch that pops them up. Hold B (or C) through the twirl to dash through them and punch from behind (crosses up)."},
    "Air Twirling Star Fist": {"group": "Twirling Star Fist"},
    "Supernova Fist": {"desc": "Invincible punch with a big light: knocks them to the edge of the screen and they bounce back toward her for a juggle."},
    "Star Rush": {"desc": "Out of Star Fist: dash punch in any of eight directions. Upward rushes carry them up with her."},
    "Rising Star": {"desc": "Uppercut that carries them up above her fist (B goes higher and starts invincible). Once per jump in the air."},
    "Falling Star": {"desc": "A, B or C at Rising Star's top: a beam down at an angle that slams them to the floor."},
    "Spiral Star": {"desc": "Invincible. On hit she holds the pose, then spins high into the sky with them on her fist and launches them at the top."},
    "Meteor Drop": {"states": [82, 84], "desc": "Rising knee, then a falling punch (block standing) into a ground impact. B goes higher."},
    "Air Meteor Drop": {"group": "Meteor Drop"},
    "Meteor Impact": {"states": [83, 85], "desc": "Invincible start, higher knee; the impact is a pillar of light that launches them high."},
    "Star Charge A": {"hide": true},
    "Star Charge B": {"hide": true},
    "Star Charge C": {"hide": true},
    "Star Charge": {"hide": true, "states": [115], "tags": ["STARS"], "desc": "A: +1 star, B: +2, C: all 3 with a flash and a moment of super armor. Each star lets a special cancel into a different special."},
    "Radiant Breaker": {"states": [92, 93], "desc": "Windmill windup and dash punch; on hit radiant energy swirls around her fist, then the point-blank radiant burst."},
    "Big Bang Crash": {"states": [94, 95], "desc": "A long twirl, then a rising punch: she rockets into the sky with them, slams them at the top and drags them down into an explosion."},
    "Throw": {"desc": "Close range. 4 + B+C throws behind you."},
    "Air Throw": {"desc": "Throw in the air, close range."}
  }
}
